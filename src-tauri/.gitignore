# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# Generated by `tauri android init` + scripts/android-configure.mjs, and holding a
# ~17 MB compiled croc under jniLibs. Regenerated on every build, so our deltas
# live in scripts/android-configure.mjs rather than committed template output.
/gen/android

# Fetched at build time by scripts/fetch-croc.mjs (bundled croc sidecars)
/binaries/
